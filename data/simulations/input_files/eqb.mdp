title  = Kremer-Grest Model in Implicit Water

integrator  = sd        ; Leap frog integrator
dt          = 0.005     ; Timestep (ps)
nsteps      = 100000       ; Simulation duration (timesteps)
nstcomm     = 250       ; Center of mass motion removal interval
comm_mode   = linear    ; Center of mass motion removal mode

;################################## ENSEMBLE ###################################
tcoupl                   = nose-hoover
ref_t       = 120.74       ; System temperature (K)
tau_t       = 0.5       ; Thermostat time constant (ps)
tc_grps     = System    ; Apply thermostat to complete system
;constraints = all-bonds
;constraint-algorithm = LINCS
;shake-tol = 0.0001
;lincs-iter  = 1
gen_vel     = yes
gen-temp    = 120.74
gen-seed    = -1

;############################## IMPLICIT SOLVENT ###############################
;implicit_solvent = GBSA ; Generalized Born implicit solvent
;gb_algorithm     = HCT  ; Hawkins-Cramer-Truhlar radii calculation
;rgbradii         = 0.0  ; Cutoff for Born radii calculation (A)

;########################### NONBONDED INTERACTIONS ############################
cutoff_scheme = verlet   ; Method of managing neighbor lists
pbc           = xyz      ; Periodic boundary conditions disabled
coulombtype   = cut-off ; Calculate coulomb interactions using cutoff
rcoulomb      = 2.5     ; Coulomb cutoff of infinity
vdw_type      = cut-off  ;user 	; Calculate van der Waals interactions using cutoff
vdw-modifier   = potential-shift
rvdw          = 2.5     ; Van der Waals cutoff of infinity
rlist         = 2.5     ; Neighbor list cutoff
nstlist       = 10       ; Do not update neighbor list

;################################### OUTPUT ####################################
nstlog        = 1000      ; Log output interval (timesteps)
nstenergy     = 1000      ; Energy output interval (timesteps)
nstcalcenergy = 100      ; Energy calculation interval (timesteps)
nstxout       = 1000      ; Trajectory output interval (timesteps)
nstvout       = 1000      ; Velocity outout interval (timesteps)
nstfout       = 1000      ; Force output interval (timesteps)
;nstxtcout                = 1
nstxout-compressed = 1000
xtc-precision            = 1000
;########################### ENERGY GROUPS #####################################
;energygrps        = KGP LJQ 
;energygrp_table   = KGP KGP KGP LJQ
