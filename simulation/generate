#!/usr/bin/env python3
"""
mlgo : Pipeline CLI
"""

import argparse
import subprocess
import sys
import os
import yaml
from pathlib import Path


step1 = "ising_generator.py"
step2 = "build_surface.py"
step3 = "build_polymer.py"
step4 = "build_box.py"

LOGFILE = Path("pipeline.log")


def run(cmd, verbose=False):
    with LOGFILE.open("a") as log:
        if verbose:
            result = subprocess.run(cmd)
        else:
            result = subprocess.run(
                cmd,
                stdout=log,
                stderr=log,
            )


def load_config(path):
    with open(path, "r") as f:
        return yaml.safe_load(f)


def cmd_surface(args):
    outdir = f"topology/surface_fraction_{args.fraction}"

    run(
        [
            args.python, step1,
            "--mode", "surface",
            "--fraction", str(args.fraction),
            "--n_systems", str(args.n),
            "--out_dir", outdir,
        ],
        verbose=args.verbose,
    )

    run(
        [args.python, step2],
        verbose=args.verbose,
    )


def cmd_polymer(args):
    outdir = f"topology/polymer_fraction_{args.fraction}"

    run(
        [
            args.python, step1,
            "--mode", "polymer",
            "--fraction", str(args.fraction),
            "--n_systems", str(args.n),
            "--out_dir", outdir,
        ],
        verbose=args.verbose,
    )

    run(
        [args.python, step3],
        verbose=args.verbose,
    )


def cmd_box(args):
    run(
        [
            args.python, step4,
            "--surface_dir", f"topology/surface_fraction_{args.surface_fraction}",
            "--polymer_dir", f"topology/polymer_fraction_{args.polymer_fraction}",
            "--surface_id", args.surface_id,
            "--polymer_id", args.polymer_id,
        ],
        verbose=args.verbose,
    )


def cmd_run(args):
    cfg = load_config(args.config)

    python = cfg.get("python", "python3")

    cmd_surface(
        argparse.Namespace(
            python=python,
            fraction=cfg["surface"]["fraction"],
            n=cfg["surface"]["n_systems"],
            verbose=args.verbose,
        )
    )

    cmd_polymer(
        argparse.Namespace(
            python=python,
            fraction=cfg["polymer"]["fraction"],
            n=cfg["polymer"]["n_systems"],
            verbose=args.verbose,
        )
    )

    cmd_box(
        argparse.Namespace(
            python=python,
            surface_fraction=cfg["surface"]["fraction"],
            polymer_fraction=cfg["polymer"]["fraction"],
            surface_id=cfg["box"]["surface_id"],
            polymer_id=cfg["box"]["polymer_id"],
            verbose=args.verbose,
        )
    )


def main():

    parser = argparse.ArgumentParser(
        description="Pipelined script"
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    p_surf = subparsers.add_parser("surface", help="Generate surfaces")
    p_surf.add_argument("--fraction", type=float, required=True)
    p_surf.add_argument("--n", type=int, required=True)
    p_surf.add_argument("--python", default="python3")
    p_surf.add_argument("--verbose", action="store_true")
    p_surf.set_defaults(func=cmd_surface)

    p_pol = subparsers.add_parser("polymer", help="Generate polymers")
    p_pol.add_argument("--fraction", type=float, required=True)
    p_pol.add_argument("--n", type=int, required=True)
    p_pol.add_argument("--python", default="python3")
    p_pol.add_argument("--verbose", action="store_true")
    p_pol.set_defaults(func=cmd_polymer)

    p_box = subparsers.add_parser("box")
    p_box.add_argument("--surface_fraction", type=float, required=True)
    p_box.add_argument("--polymer_fraction", type=float, required=True)
    p_box.add_argument("--surface_id", required=True)
    p_box.add_argument("--polymer_id", required=True)
    p_box.add_argument("--python", default="python3")
    p_box.add_argument("--verbose", action="store_true")
    p_box.set_defaults(func=cmd_box)

    p_run = subparsers.add_parser("run", help="Run pipeline from YAML config")
    p_run.add_argument("--config", required=True)
    p_run.add_argument("--verbose", action="store_true")
    p_run.set_defaults(func=cmd_run)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

